rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access to authenticated users for development
    // WARNING: This is for development only! Do not use in production.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // More restrictive rules for production (commented out for now)
    // Uncomment and modify these rules for production use:
    
    // Users collection - users can read/write their own data
    // match /users/{userId} {
    //   allow read, write: if request.auth != null && request.auth.uid == userId;
    // }
    
    // Employees collection - authenticated users can read, only admins can write
    // match /employees/{employeeId} {
    //   allow read: if request.auth != null;
    //   allow write: if request.auth != null && 
    //     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'administrator';
    // }
    
    // Positions and departments - authenticated users can read, only admins can write
    // match /positions/{positionId} {
    //   allow read: if request.auth != null;
    //   allow write: if request.auth != null && 
    //     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'administrator';
    // }
    
    // match /departments/{departmentId} {
    //   allow read: if request.auth != null;
    //   allow write: if request.auth != null && 
    //     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'administrator';
    // }
  }
}
